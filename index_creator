</header>

<section class="hero">
  <div class="wrap">
    <svg class="route" viewBox="0 0 340 90" xmlns="http://www.w3.org/2000/svg">
      <path d="M20,70 C 100,10 240,10 320,70" fill="none" stroke="#1E4470" stroke-width="1.5"/>
      <circle cx="20" cy="70" r="5" fill="#A63A2E"/>
      <circle cx="320" cy="70" r="5" fill="#1E4470"/>
      <text x="20" y="86" font-family="IBM Plex Sans, sans-serif" font-size="10" fill="#4A4A47" text-anchor="middle">Asia</text>
      <text x="320" y="86" font-family="IBM Plex Sans, sans-serif" font-size="10" fill="#4A4A47" text-anchor="middle">Europe</text>
    </svg>
    <h1 data-i18n="hero.h1">Expand your creative empire and audience into Europe from Portugal.</h1>
    <p class="lead" data-i18n="hero.lead">We partner with top Asian creators, influencers, and digital talents to bridge markets, secure European residency, and scale brand monetization across the EU.</p>
    <div class="cta-row">
      <a href="#contact" class="btn btn-primary" data-i18n="hero.ctaPrimary">Apply for Creator Partnership</a>
      <a href="#services" class="btn btn-ghost" data-i18n="hero.ctaGhost">Explore creator tracks</a>
    </div>
  </div>
