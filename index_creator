      <h2 data-i18n="contact.h2">Book your creator consultation.</h2>
      <p data-i18n="contact.p">Tell us about your channels, platforms, and vision for Europe. Our team will review and reply within two business days.</p>
    </div>
    <form id="consultation-form" action="https://formspree.io/f/xzezrylk" method="POST">
      <div>
        <label for="name" data-i18n="label.name">Creator / Agency Name</label>
        <input type="text" id="name" name="name" required data-i18n-placeholder="name.placeholder" placeholder="Your name or channel name">
      </div>
      <div>
        <label for="email" data-i18n="label.email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com">
      </div>
      <div>
        <label for="business" data-i18n="label.business">Primary Platform &amp; Handle / Link</label>
        <input type="text" id="business" name="business" data-i18n-placeholder="business.placeholder" placeholder="e.g. YouTube / TikTok / Instagram link">
      </div>
      <div>
        <label for="timeline" data-i18n="label.timeline">What is your primary goal?</label>
        <select id="timeline" name="timeline">
          <option data-i18n="opt1">European Brand Deals &amp; Sponsorships</option>
          <option data-i18n="opt2">EU Company Setup &amp; Visa Residency</option>
          <option data-i18n="opt3">Full Creator Management &amp; Expansion</option>
        </select>
      </div>
      <div>
        <div class="label-row">
          <label for="message" data-i18n="label.message">Tell us about your audience and goals</label>
          <span id="char-count" class="char-count">0/500</span>
        </div>
        <textarea id="message" rows="3" name="message" maxlength="500" data-i18n-placeholder="message.placeholder" placeholder="Optional"></textarea>
      </div>
      <label class="consent">
        <input type="checkbox" id="consent" name="gdpr_consent" required>
        <span data-i18n="label.consent">Information you submit is used only to respond to your enquiry and is processed in accordance with EU GDPR</span>
      </label>
      <button type="submit" id="submit-btn" class="btn btn-primary" data-i18n="btn.submit">Submit Creator Application</button>
      <div id="form-status" style="margin-top:12px; font-size:0.9rem; color:#8FB4DA;"></div>
    </form>
  </div>
</section>

<footer>
  <div class="wrap">
    <p class="disclaimer" data-i18n="footer.disclaimer">Okaerinasai Creators provides creator strategy consulting, cross-border brand partnerships, and relocation coordination. Formal legal representation, visa filings, and tax advisory are provided by our licensed Portuguese partners. Outcomes depend on individual talent metrics and circumstances.</p>
    <p class="copy" data-i18n="footer.copy">© 2026 Okaerinasai Creators. Lisbon, Portugal.</p>
  </div>
</footer>

<script>
const translations = {
  ja: {
    "nav.services":"プログラム","nav.process":"流れ","nav.about":"会社概要","nav.faq":"よくある質問","nav.contact":"応募する",
